<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/test_title" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/instruction_text" android:textSize="16sp" />
        <Button android:id="@+id/btnEnableService" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp"
            android:text="@string/enable_service" />
        <TextView android:id="@+id/tvServiceStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/service_status_stopped" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/video_url_label" android:textSize="16sp" />
        <EditText android:id="@+id/videoUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="textUri" android:autofillHints=""
            android:hint="@string/video_url_hint" android:maxLength="500" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/video_marker_label" android:textSize="16sp" />
        <EditText android:id="@+id/videoMarker" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="textCapSentences|textMultiLine" android:autofillHints=""
            android:hint="@string/video_marker_hint" android:maxLength="200" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:labelFor="@id/navigationCount" android:text="@string/navigation_count_label" android:textSize="16sp" />
        <EditText android:id="@+id/navigationCount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="number" android:autofillHints="" android:maxLength="1" android:text="@string/default_navigation_count" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:labelFor="@id/awaySeconds" android:text="@string/away_seconds_label" android:textSize="16sp" />
        <EditText android:id="@+id/awaySeconds" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="number" android:autofillHints="" android:maxLength="2" android:text="@string/default_away_seconds" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:labelFor="@id/playbackTimeout" android:text="@string/playback_timeout_label" android:textSize="16sp" />
        <EditText android:id="@+id/playbackTimeout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="number" android:autofillHints="" android:maxLength="3" android:text="@string/default_playback_timeout" />
        <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginTop="24dp" android:text="@string/start_test" />
        <Button android:id="@+id/btnStop" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/stop_test" android:enabled="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/result_title" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvResult" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/no_session" android:textSize="16sp" android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/measurement_note" android:textSize="14sp" />
        <Button android:id="@+id/btnExport" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/export_logs" android:enabled="false" />
    </LinearLayout>
</ScrollView>
